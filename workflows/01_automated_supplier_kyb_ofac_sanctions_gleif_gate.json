          "assignments": [
            {
              "id": "assign-1",
              "name": "vendorName",
              "value": "ACME GLOBAL LOGISTICS LTD",
              "type": "string"
            },
            {
              "id": "assign-2",
              "name": "countryCode",
              "value": "US",
              "type": "string"
            },
            {
              "id": "assign-3",
              "name": "leiCode",
              "value": "5493001KJTIIGC8Y1R12",
              "type": "string"
            },
            {
              "id": "assign-4",
              "name": "invoiceAmountUsd",
              "value": 48500,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "wf1-normalize",
      "name": "Normalize Intake Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://global-sanctions-pep-interpol-watchlist-screener.p.rapidapi.com/v2/acts/b2b-quant-apis~global-sanctions-pep-interpol-watchlist-screener/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Host",
              "value": "global-sanctions-pep-interpol-watchlist-screener.p.rapidapi.com"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"entityName\": \"={{ $json.vendorName }}\", \"entityType\": \"ORGANIZATION\", \"maxResults\": 10}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "wf1-http-1",
      "name": "Primary Compliance Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://global-gleif-lei-corporate-ownership-kyb.p.rapidapi.com/v2/acts/b2b-quant-apis~global-gleif-lei-corporate-ownership-kyb/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Host",
              "value": "global-gleif-lei-corporate-ownership-kyb.p.rapidapi.com"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"companyName\": \"={{ $('Normalize Intake Payload').item.json.vendorName }}\", \"countryCode\": \"={{ $('Normalize Intake Payload').item.json.countryCode }}\", \"maxResults\": 10}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "wf1-http-2",
      "name": "Secondary Verification Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const intake = $('Normalize Intake Payload').first().json;\nconst primaryItems = $('Primary Compliance Engine').all().map(i => i.json);\nconst secondaryItems = $input.all().map(i => i.json);\nconst combinedCount = primaryItems.length + secondaryItems.length;\nconst serialized = JSON.stringify({ primaryItems, secondaryItems }).toLowerCase();\nlet riskScore = 20;\nif (serialized.includes('critical') || serialized.includes('sanction') || serialized.includes('invalid') || serialized.includes('ransomware')) {\n  riskScore = 85;\n} else if (combinedCount > 0) {\n  riskScore = 65;\n}\nreturn [{\n  json: {\n    auditedAtUtc: new Date().toISOString(),\n    workflowSlug: '01_automated_supplier_kyb_ofac_sanctions_gleif_gate',\n    intakeSummary: intake,\n    primaryFindingsCount: primaryItems.length,\n    secondaryFindingsCount: secondaryItems.length,\n    riskScore,\n    requiresAction: riskScore >= 60\n  }\n}];"
      },
      "id": "wf1-score",
      "name": "Correlate & Score Findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.riskScore }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf1-if-gate",
      "name": "Priority Gate (Score >= 60)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1500,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "wf1-escalate",
      "name": "Dispatch Priority Alert Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
